# ==============================================================================
# NewsAI Agent Environment Configuration Template
# Copy this file to .env and populate your actual API keys.
# DO NOT commit the .env file containing real keys to version control.
# ==============================================================================

# Required: Google Gemini API Key for Google ADK & Gemini 2.5 Flash Lite
# Obtain your API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: NewsAPI Key
# Enables precise topic-based search. Obtain a free key at: https://newsapi.org/register
# If omitted or quota exhausted, NewsAI automatically falls back to curated RSS feeds.
NEWSAPI_KEY=your_newsapi_key_here
